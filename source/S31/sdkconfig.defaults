# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) Project Minimal Configuration
#
CONFIG_IDF_TARGET="esp32s31"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_250M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_MEMTEST=n
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=12768
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_BSP_LCD_RGB_BUFFER_NUMS=2
# CONFIG_BSP_LCD_RGB_BOUNCE_BUFFER_MODE is not set
CONFIG_BSP_LCD_RGB_REFRESH_AUTO=y
CONFIG_BSP_DISPLAY_LVGL_AVOID_TEAR=y
CONFIG_BSP_DISPLAY_LVGL_DIRECT_MODE=y
#CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y
CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE=n

# Camera config
CONFIG_ESP_VIDEO_ENABLE_SPI_VIDEO_DEVICE=n
CONFIG_CAMERA_XCLK_USE_LEDC=y
CONFIG_CAMERA_OV3660=y
CONFIG_CAMERA_OV3660_DVP_RGB565_BE_640X480_10FPS=y
CONFIG_CAMERA_OV3660_DVP_DEFAULT_FMT_RGB565_BE_640X480_10FPS=y
CONFIG_CAMERA_SC101IOT=y
CONFIG_CAMERA_SC101IOT_DVP_YUV422_640X480_15FPS=y
CONFIG_CAMERA_SC101IOT_DVP_DEFAULT_FMT_YUV422_640X480_15FPS=y
CONFIG_CAM_CTRL_SPI_ENABLE=n

# AI models live in dedicated flash partitions. The partitions are declared
# in partitions.csv so the application image remains comfortably below 5 MB.
CONFIG_FLASH_HUMAN_FACE_DETECT_MSRMNP_S8_V1=y
CONFIG_HUMAN_FACE_DETECT_MSRMNP_S8_V1=y
CONFIG_DEFAULT_HUMAN_FACE_DETECT_MODEL=0
# CONFIG_HUMAN_FACE_DETECT_MODEL_IN_FLASH_RODATA is not set
CONFIG_HUMAN_FACE_DETECT_MODEL_IN_FLASH_PARTITION=y
# CONFIG_HUMAN_FACE_DETECT_MODEL_IN_SDCARD is not set
CONFIG_HUMAN_FACE_DETECT_MODEL_LOCATION=1

CONFIG_FLASH_HUMAN_FACE_FEAT_MFN_S8_V1=y
# CONFIG_FLASH_HUMAN_FACE_FEAT_MBF_S8_V1 is not set
CONFIG_HUMAN_FACE_FEAT_MFN_S8_V1=y
CONFIG_DEFAULT_HUMAN_FACE_FEAT_MODEL=0
# CONFIG_HUMAN_FACE_FEAT_MODEL_IN_FLASH_RODATA is not set
CONFIG_HUMAN_FACE_FEAT_MODEL_IN_FLASH_PARTITION=y
# CONFIG_HUMAN_FACE_FEAT_MODEL_IN_SDCARD is not set
CONFIG_HUMAN_FACE_FEAT_MODEL_LOCATION=1

# YOLO11n-320 is the practical COCO detector for the S31's CPU budget.
# CONFIG_FLASH_COCO_DETECT_YOLO11N_S8_V1 is not set
CONFIG_FLASH_COCO_DETECT_YOLO11N_320_S8_V1=y
# CONFIG_COCO_DETECT_YOLO11N_S8_V1 is not set
CONFIG_COCO_DETECT_YOLO11N_320_S8_V1=y
CONFIG_DEFAULT_COCO_DETECT_MODEL=1
# CONFIG_COCO_DETECT_MODEL_IN_FLASH_RODATA is not set
CONFIG_COCO_DETECT_MODEL_IN_FLASH_PARTITION=y
# CONFIG_COCO_DETECT_MODEL_IN_SDCARD is not set
CONFIG_COCO_DETECT_MODEL_LOCATION=1

## LVGL9 ##
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_BUILD_EXAMPLES=n

#CLIB default
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_USE_CLIB_STRING=y

# The application renders its own Chinese status bar. LVGL's English
# performance overlay overlaps that UI and is not part of the product.
# CONFIG_LV_USE_OBSERVER is not set
# CONFIG_LV_USE_SYSMON is not set
# CONFIG_LV_USE_PERF_MONITOR is not set

## LVGL8 - uncomment, when using LVGL8 ##
# CONFIG_LV_USE_PERF_MONITOR=y
# CONFIG_LV_COLOR_16_SWAP=y
# CONFIG_LV_MEM_CUSTOM=y
# CONFIG_LV_MEMCPY_MEMSET_STD=y
# CONFIG_LV_SPRINTF_CUSTOM=y

CONFIG_LV_USE_FLOAT=y
CONFIG_LV_USE_GESTURE_RECOGNITION=y
